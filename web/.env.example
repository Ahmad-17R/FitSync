# FitSync — environment
#
# Copy to .env.local for development.

# The form-checking backend. Both the REST base and the WebSocket base are
# derived from this single value (https:// -> wss://, http:// -> ws://), so
# there is only ever one URL to change.
#
#   local dev   http://localhost:8000
#   production  https://exercise-form-backend.onrender.com
NEXT_PUBLIC_FORM_COACH_URL=https://exercise-form-backend.onrender.com

# Optional overrides. Leave unset to use the self-hosted copies that
# `npm run assets` places in public/ — that is the supported path.
# NEXT_PUBLIC_MEDIAPIPE_MODEL_PATH=/models/pose_landmarker_lite.task
# NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=/mediapipe/wasm

# Supabase — accounts, plans and practice history.
# Project: zenflow (ap-south-1). The publishable key is safe in the client:
# every table is protected by row-level security, so it grants nothing on its
# own. Never put the service_role key here — it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://exkszsshhnkbzvaghmrg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VhFTd5dL5zrJSVs7_djVtA_tGC0P3Al

# Optional. The public origin used to build sign-in callback URLs.
#
# Only needed for a custom domain — on Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL (production) or VERCEL_URL (previews), and
# locally it falls back to http://localhost:3000.
#
# It is deliberately NOT read from request headers: a forged X-Forwarded-Host
# would otherwise end up inside an emailed sign-in link.
# NEXT_PUBLIC_SITE_URL=https://web-kappa-liard.vercel.app
