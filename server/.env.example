# FitSync yoga API — environment
# Copy to .env for local development. Every value below is a default; the
# server runs with none of them set.

HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated, matched as EXACT strings. localhost:3000 and localhost:5173
# are already defaults, so local development needs nothing here.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Regex for preview deployments. This — not a wildcard inside CORS_ORIGINS —
# is what covers Vercel preview URLs.
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# Frames of pose loss tolerated before a hold resets. Counted in FRAMES, so
# read it against your client's frame rate: at FitSync's 12fps, 10 frames is
# about 0.8s of grace. Raise this before loosening any pose threshold — jitter
# and over-strictness look identical to the user but need opposite fixes.
# YOGA_HOLD_DEBOUNCE_FRAMES=10

# Fallback hold target for a pose that does not set its own.
# YOGA_DEFAULT_HOLD_SECONDS=20.0

# Per-frame DEBUG logging. Very noisy; for threshold tuning only.
# DETECTION_DEBUG_LOG=false
